# Academic Agent Environment Configuration Template
# Copy this file to .env and configure your secrets. Do NOT commit .env to version control.

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_BASE_URL=http://localhost:8000
CUSTOM_DOMAIN=localhost
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cryptographic Secret Key (Generate a 32+ character random secret for production)
SECRET_KEY=replace-with-a-cryptographically-secure-random-token-min-32-chars

# Database
DATABASE_URL=sqlite:///./academic_agent.db

# Google Classroom OAuth 2.0 Credentials (Google Cloud Console Desktop/Web App)
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# AI Provider API Keys (Optional - offline deterministic engine will run if keys are not set)
GEMINI_API_KEY=
GROQ_API_KEY=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL=120
RATE_LIMIT_SENSITIVE=20

# Scheduler & Validation Limits
SCHEDULER_INTERVAL_SECONDS=10
DEFAULT_AUTO_SUBMIT_OFFSET_HOURS=4.0
CODE_EXECUTION_TIMEOUT_SECONDS=8

